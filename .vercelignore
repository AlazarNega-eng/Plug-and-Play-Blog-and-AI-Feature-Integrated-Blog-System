# Ignore development files
node_modules
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore server files that aren't needed for API
server/node_modules
server/uploads
server/test.js
server/server*.js

# Ignore client development files
client/node_modules
client/README.md

# Keep client source files for build
!client/src
!client/public
!client/vite.config.js
!client/index.html
!client/package.json
!client/package-lock.json

# Keep only built client files
!client/dist
